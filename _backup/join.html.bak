<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Join | Harare Regional Chamber of Commerce</title>
    <meta name="description" content="Membership application form for the Harare Regional Chamber of Commerce.">
    <meta name="author" content="Masango Dewheretsoko">
    
    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="Join the Harare Regional Chamber of Commerce">
    <meta property="og:description" content="Apply for membership with the Harare Regional Chamber of Commerce and connect with local businesses across the region.">
    <meta property="og:image" content="https://Masango763.github.io/wdd231/chamber/images/logo.svg">
    <meta property="og:url" content="https://Masango763.github.io/wdd231/chamber/join.html">
    
    <link rel="icon" href="images/favicon.ico">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="styles/normalize.css">
    <link rel="stylesheet" href="styles/small.css">
    <link rel="stylesheet" href="styles/larger.css">
    <script src="scripts/navigation.js" defer></script>
    <script src="scripts/join.js" defer></script>
</head>
<body>
    <header>
        <div class="logo-box">
            <img src="images/logo.svg" alt="Harare Chamber Logo">
            <h1>Harare Regional Chamber of Commerce</h1>
        </div>
        <nav>
            <button id="menu" aria-label="Toggle navigation menu"></button>
            <ul class="navigation">
                <li><a href="index.html">Home</a></li>
                <li><a href="discover.html">Discover</a></li>
                <li><a href="directory.html">Directory</a></li>
                <li><a href="join.html" class="active">Join</a></li>
            </ul>
        </nav>
    </header>

    <main class="join-main">
        <h1>Join the Harare Regional Chamber of Commerce</h1>
        
        <form method="get" action="thankyou.html" class="join-form">
            <fieldset>
                <legend>Applicant Personal Information</legend>
                
                <label for="first">First Name*</label>
                <input type="text" id="first" name="first" required autocomplete="given-name" title="Please enter your first name">
                
                <label for="last">Last Name*</label>
                <input type="text" id="last" name="last" required autocomplete="family-name" title="Please enter your last name">
                
                <label for="title">Organizational Title</label>
                <input type="text" id="title" name="title" pattern="[A-Za-z\s\-]{7,}" autocomplete="organization-title" title="Enter your organizational title (minimum 7 characters)">
                
                <label for="email">Email Address*</label>
                <input type="email" id="email" name="email" required placeholder="example@domain.com" autocomplete="email" title="Please enter a valid email address">
                
                <label for="phone">Mobile Phone*</label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" title="Please enter a valid mobile phone number">
            </fieldset>

            <fieldset>
                <legend>Organization & Membership Information</legend>
                
                <label for="orgname">Organization Name*</label>
                <input type="text" id="orgname" name="orgname" required autocomplete="organization" title="Please enter your business or organization name">
                
                <p>Membership Level*</p>
                <label><input type="radio" name="membership" value="np" required title="Select NP Membership"> NP Membership (Non-Profit - No Fee)</label>
                <label><input type="radio" name="membership" value="bronze" title="Select Bronze Membership"> Bronze Membership</label>
                <label><input type="radio" name="membership" value="silver" title="Select Silver Membership"> Silver Membership</label>
                <label><input type="radio" name="membership" value="gold" title="Select Gold Membership"> Gold Membership</label>
                
                <label for="description">Organization Description</label>
                <textarea id="description" name="description" title="Provide a brief description of your organization"></textarea>
            </fieldset>

            <!-- Required Hidden Timestamp Input -->
            <input type="hidden" id="timestamp" name="timestamp">

            <button type="submit" class="submit-btn">Join the Chamber</button>
        </form>

        <section class="membership-levels-info">
            <div class="card">
                <h2>NP Membership</h2>
                <button type="button" class="modal-btn" data-modal="np-modal">Learn More</button>
            </div>
            <div class="card">
                <h2>Bronze Membership</h2>
                <button type="button" class="modal-btn" data-modal="bronze-modal">Learn More</button>
            </div>
            <div class="card">
                <h2>Silver Membership</h2>
                <button type="button" class="modal-btn" data-modal="silver-modal">Learn More</button>
            </div>
            <div class="card">
                <h2>Gold Membership</h2>
                <button type="button" class="modal-btn" data-modal="gold-modal">Learn More</button>
            </div>
        </section>

        <!-- HTML Dialog Modal Element -->
        <dialog id="membership-modal">
            <button id="closeModal">❌</button>
            <div id="modal-content">
                <h2>Membership Details</h2>
                <p>Review the benefits associated with this level.</p>
            </div>
        </dialog>
    </main>

    <footer>
        <div class="footer-info">
            <img src="images/logo.svg" alt="Harare Chamber Footer Logo">
            <h3>Harare Regional Chamber of Commerce</h3>
            <p>123 Jason Moyo Avenue, Harare, Zimbabwe</p>
            <p>info@hararechamber.co.zw</p>
            <p>+263 4 123 456</p>
        </div>
        <div class="footer-social">
            <a href="https://facebook.com" target="_blank">f</a>
            <a href="https://twitter.com" target="_blank">t</a>
            <a href="https://linkedin.com" target="_blank">in</a>
            <a href="https://youtube.com" target="_blank">yt</a>
        </div>
        <div class="footer-bottom">
            <p>&copy; <span id="current-year"></span> Harare Regional Chamber | Masango Dewheretsoko | WDD 231</p>
            <p>Last Modification: <span id="lastModified"></span></p>
        </div>
    </footer>
</body>
</html>
